rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && myRole() == "super-admin";
    }

    function isAdmin() {
      return isSignedIn() && myRole() == "admin";
    }

    function isStaff() {
      return isAdmin() || isSuperAdmin();
    }

    // users/{uid} - a user can only read their own document.
    // Anyone can create their own document during signup, but only with
    // role="customer" - so nobody can self-assign admin/super-admin.
    // Staff (admin/super-admin) can read every user document.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == "customer";
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // tokens - a customer can only create their own token (status must
    // start as "waiting"). Any signed-in user can read the queue (needed
    // for the live queue view). Only staff can change status/order.
    match /tokens/{tokenId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.customerUid == request.auth.uid
                    && request.resource.data.status == "waiting";
      allow update: if isStaff();
      allow delete: if isSuperAdmin();
    }

    // counters - used only to generate sequential token numbers per day.
    match /counters/{dateKey} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
